<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_otono"
    android:orientation="vertical">

    <include layout="@layout/cabecera" />

    <!-- Las 5 actividades de la estacion -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/actRelaciona"
            android:layout_width="140dp"
            android:layout_height="180dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_tarjeta"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/imgRelaciona"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_foto"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/foto_bosque" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="@string/relaciona"
                android:textColor="@color/texto_oscuro"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actVestir"
            android:layout_width="140dp"
            android:layout_height="180dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_tarjeta"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/imgVestir"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_foto"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/foto_abrigo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="@string/vesteix"
                android:textColor="@color/texto_oscuro"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actCanciones"
            android:layout_width="140dp"
            android:layout_height="180dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_tarjeta"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/imgCanciones"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_foto"
                android:importantForAccessibility="no"
                android:padding="24dp"
                android:src="@drawable/ic_musica" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="@string/cancons_dibuix"
                android:textColor="@color/texto_oscuro"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actArbol"
            android:layout_width="140dp"
            android:layout_height="180dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_tarjeta"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/imgArbol"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_foto"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/foto_hojas_marrones" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="@string/arbre"
                android:textColor="@color/texto_oscuro"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actMochila"
            android:layout_width="140dp"
            android:layout_height="180dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_tarjeta"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/imgMochila"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_foto"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/foto_paraguas" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="@string/motxilla"
                android:textColor="@color/texto_oscuro"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
