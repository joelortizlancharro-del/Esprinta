<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/estacion_verano">

    <!-- Tarjeta central -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_estacion"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circulo"
                android:backgroundTint="@color/estacion_primavera"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_primavera" />
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circulo"
                android:backgroundTint="@color/estacion_verano"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_verano" />
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circulo"
                android:backgroundTint="@color/estacion_otono"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_otono" />
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circulo"
                android:backgroundTint="@color/estacion_invierno"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_invierno" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/molt_be"
            android:textColor="@color/texto_oscuro"
            android:textSize="@dimen/titulo_size" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnInicio"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_boton_oscuro"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="5dp"
                android:text="@string/inici"
                android:textColor="@color/blanco"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnOtraEstacion"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_boton_verde"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="5dp"
                android:text="@string/altra_estacio"
                android:textColor="@color/blanco"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
