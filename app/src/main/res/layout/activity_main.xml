<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema"
    tools:context=".MainActivity">

    <!-- Botón ayuda (arriba a la derecha) -->
    <TextView
        android:id="@+id/btnAyuda"
        android:layout_width="40dp"
        android:layout_height="43dp"
        android:layout_marginTop="@dimen/margen_pantalla"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:background="@drawable/bg_boton_blanco"
        android:contentDescription="@string/cd_ayuda"
        android:gravity="center"
        android:paddingBottom="3dp"
        android:text="@string/ayuda"
        android:textColor="@color/texto_oscuro"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bloque central: título + estaciones + jugar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.46">

        <!-- Título ESPRINTA con letras de colores -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tituloEs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/titulo_es"
                android:textColor="@color/titulo_amarillo"
                android:textSize="@dimen/titulo_size" />

            <TextView
                android:id="@+id/tituloPri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/titulo_pri"
                android:textColor="@color/titulo_rosa"
                android:textSize="@dimen/titulo_size" />

            <TextView
                android:id="@+id/tituloN"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/titulo_n"
                android:textColor="@color/titulo_azul"
                android:textSize="@dimen/titulo_size" />

            <TextView
                android:id="@+id/tituloTa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/titulo_ta"
                android:textColor="@color/titulo_naranja"
                android:textSize="@dimen/titulo_size" />
        </LinearLayout>

        <!-- Iconos de las 4 estaciones -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgPrimavera"
                android:layout_width="@dimen/icono_estacion"
                android:layout_height="@dimen/icono_estacion"
                android:background="@drawable/bg_circulo"
                android:backgroundTint="@color/estacion_primavera"
                android:contentDescription="@string/cd_primavera"
                android:padding="@dimen/icono_estacion_padding"
                android:src="@drawable/ic_primavera" />

            <ImageView
                android:id="@+id/imgVerano"
                android:layout_width="@dimen/icono_estacion"
                android:layout_height="@dimen/icono_estacion"
                android:layout_marginStart="@dimen/separacion_estaciones"
                android:background="@drawable/bg_circulo"
                android:backgroundTint="@color/estacion_verano"
                android:contentDescription="@string/cd_verano"
                android:padding="@dimen/icono_estacion_padding"
                android:src="@drawable/ic_verano" />

            <ImageView
                android:id="@+id/imgOtono"
                android:layout_width="@dimen/icono_estacion"
                android:layout_height="@dimen/icono_estacion"
                android:layout_marginStart="@dimen/separacion_estaciones"
                android:background="@drawable/bg_circulo"
                android:backgroundTint="@color/estacion_otono"
                android:contentDescription="@string/cd_otono"
                android:padding="@dimen/icono_estacion_padding"
                android:src="@drawable/ic_otono" />

            <ImageView
                android:id="@+id/imgInvierno"
                android:layout_width="@dimen/icono_estacion"
                android:layout_height="@dimen/icono_estacion"
                android:layout_marginStart="@dimen/separacion_estaciones"
                android:background="@drawable/bg_circulo"
                android:backgroundTint="@color/estacion_invierno"
                android:contentDescription="@string/cd_invierno"
                android:padding="@dimen/icono_estacion_padding"
                android:src="@drawable/ic_invierno" />
        </LinearLayout>

        <!-- Botón JUGAR -->
        <LinearLayout
            android:id="@+id/btnJugar"
            android:layout_width="@dimen/boton_jugar_ancho"
            android:layout_height="@dimen/boton_jugar_alto"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_boton_verde"
            android:clickable="true"
            android:contentDescription="@string/cd_jugar"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="5dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_play" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/jugar"
                android:textColor="@color/blanco"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botón PROFESSORAT (abajo a la derecha) -->
    <LinearLayout
        android:id="@+id/btnProfessorat"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:layout_marginBottom="@dimen/margen_pantalla"
        android:background="@drawable/bg_boton_blanco"
        android:clickable="true"
        android:contentDescription="@string/cd_professorat"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lock" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/professorat"
            android:textColor="@color/texto_oscuro"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
