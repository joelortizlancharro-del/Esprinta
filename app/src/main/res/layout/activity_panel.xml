<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_profe"
    android:orientation="vertical">

    <!-- Cabecera oscura del panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/cabecera_alto"
        android:background="@color/texto_oscuro"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margen_pantalla">

        <ImageView
            android:id="@+id/btnInicio"
            android:layout_width="@dimen/boton_cabecera"
            android:layout_height="@dimen/boton_cabecera"
            android:background="@drawable/bg_boton_blanco"
            android:contentDescription="@string/cd_inicio"
            android:padding="11dp"
            android:src="@drawable/ic_casa" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/panell"
            android:textColor="@color/blanco"
            android:textSize="@dimen/texto_titulo" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:padding="@dimen/margen_pantalla">

        <LinearLayout
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/bg_tarjeta"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/estacions_actives"
                android:textColor="@color/texto_oscuro"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swPrimavera"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/primavera"
                android:textColor="@color/texto_oscuro"
                android:textSize="15sp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swVerano"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/estiu"
                android:textColor="@color/texto_oscuro"
                android:textSize="15sp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swOtono"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tardor"
                android:textColor="@color/texto_oscuro"
                android:textSize="15sp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swInvierno"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/hivern"
                android:textColor="@color/texto_oscuro"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/bg_tarjeta"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/activitats"
                android:textColor="@color/texto_oscuro"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swRelaciona"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/relaciona"
                android:textColor="@color/texto_oscuro"
                android:textSize="15sp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swVestir"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/vesteix_cos"
                android:textColor="@color/texto_oscuro"
                android:textSize="15sp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swCanciones"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/cancons_dibuix"
                android:textColor="@color/texto_oscuro"
                android:textSize="15sp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swArbol"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/arbre"
                android:textColor="@color/texto_oscuro"
                android:textSize="15sp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swMochila"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/motxilla"
                android:textColor="@color/texto_oscuro"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/bg_tarjeta"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/dibuixos_desats"
                android:textColor="@color/texto_oscuro"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="96dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_foto" />

                <View
                    android:layout_width="96dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_foto" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/volum"
                android:textColor="@color/texto_oscuro"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/barraVolumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="10"
                android:progress="7" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
