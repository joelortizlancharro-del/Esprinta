                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/obj_crema"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="@dimen/texto_tarjeta" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tarjetaGorra"
                android:layout_width="110dp"
                android:layout_height="124dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_tarjeta"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_foto"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/foto_gorra" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/obj_gorra"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="@dimen/texto_tarjeta" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tarjetaBotas"
                android:layout_width="110dp"
                android:layout_height="124dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_tarjeta"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_foto"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/foto_botas" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/obj_botas"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="@dimen/texto_tarjeta" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tarjetaGuantes"
                android:layout_width="110dp"
                android:layout_height="124dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_tarjeta"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_foto"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/foto_guantes" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/obj_guantes"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="@dimen/texto_tarjeta" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tarjetaBufanda"
                android:layout_width="110dp"
                android:layout_height="124dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_tarjeta"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_foto"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/foto_bufanda" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/obj_bufanda"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="@dimen/texto_tarjeta" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tarjetaGorro"
                android:layout_width="110dp"
                android:layout_height="124dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_tarjeta"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_foto"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/foto_gorro" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/obj_gorro"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="@dimen/texto_tarjeta" />
            </LinearLayout>
        </GridLayout>
    </LinearLayout>
</LinearLayout>
