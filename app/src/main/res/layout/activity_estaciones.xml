<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema"
    android:orientation="vertical">

    <include layout="@layout/cabecera" />

    <!-- Las 4 estaciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cardPrimavera"
            android:layout_width="160dp"
            android:layout_height="250dp"
            android:layout_margin="12dp"
            android:background="@drawable/bg_estacion"
            android:backgroundTint="@color/estacion_primavera"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_foto"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/foto_jardin" />

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_primavera" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/primavera"
                android:textColor="@color/texto_oscuro"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardVerano"
            android:layout_width="160dp"
            android:layout_height="250dp"
            android:layout_margin="12dp"
            android:background="@drawable/bg_estacion"
            android:backgroundTint="@color/estacion_verano"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_foto"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/foto_playa" />

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_verano" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/estiu"
                android:textColor="@color/texto_oscuro"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardOtono"
            android:layout_width="160dp"
            android:layout_height="250dp"
            android:layout_margin="12dp"
            android:background="@drawable/bg_estacion"
            android:backgroundTint="@color/estacion_otono"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_foto"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/foto_bosque" />

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_otono" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/tardor"
                android:textColor="@color/texto_oscuro"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardInvierno"
            android:layout_width="160dp"
            android:layout_height="250dp"
            android:layout_margin="12dp"
            android:background="@drawable/bg_estacion"
            android:backgroundTint="@color/estacion_invierno"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_foto"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/foto_montana" />

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_invierno" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/hivern"
                android:textColor="@color/texto_oscuro"
                android:textSize="18sp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
